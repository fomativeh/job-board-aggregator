# --- REQUIRED --------------------------------------------------------------
# Missing any of these three raises MissingConfigError on startup.

MONGO_URI=mongodb://localhost:27017
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

MONGO_DB=job_aggregator
MONGO_COLLECTION=job_listings

# --- OPTIONAL --------------------------------------------------------------
# Missing = sensible fallback applies.

# DEBUG INFO WARNING ERROR CRITICAL. Case-insensitive. Invalid -> INFO.
# CLI --log-level overrides this when set.
LOG_LEVEL=INFO

# Additive file log in addition to stderr console log.
# Relative paths resolve from the repo root. Parent dirs created automatically.
# CLI --log-file overrides this when set. Comment out to disable.
# LOG_FILE=logs/job_aggregator.log
