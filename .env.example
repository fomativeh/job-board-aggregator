# MongoDB connection string. Local Atlas-free default: mongodb://localhost:27017
# Atlas format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb://localhost:27017

# Name of the logical database to use inside the cluster.
MONGO_DB=job_aggregator

# Name of the collection that stores deduplicated job listings.
MONGO_COLLECTION=job_listings
