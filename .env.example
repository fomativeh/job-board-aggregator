MONGO_URI=mongodb://localhost:27017
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

MONGO_DB=job_aggregator
MONGO_COLLECTION=job_listings

# DEBUG INFO WARNING ERROR CRITICAL. Case-insensitive. Invalid -> INFO.
# CLI --log-level overrides this when set.
LOG_LEVEL=INFO