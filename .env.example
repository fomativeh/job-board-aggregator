MONGO_URI=mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

MONGO_DB=job_aggregator
MONGO_COLLECTION=job_listings

# DEBUG, INFO, WARNING, ERROR, CRITICAL. Invalid values fall back to INFO.
LOG_LEVEL=INFO

# Optional: write logs to this path in addition to the console.
# LOG_FILE=logs/job_aggregator.log
